{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^write_file$",
        "hooks": [
          {
            "name": "mft-checkpoint",
            "type": "command",
            "command": "mft hook --by iris >/dev/null 2>&1; exit 0",
            "timeout": 10,
            "description": "Store a version of the file before it is overwritten."
          }
        ]
      }
    ]
  }
}
